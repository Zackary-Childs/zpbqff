#!/bin/bash
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --no-requeue
#SBATCH --mem=8gb
 
export ORCA_CMD=${ORCA_CMD:-orca}
$ORCA_CMD opt0.inp > opt0.out 2>&1
$ORCA_CMD opt1.inp > opt1.out 2>&1
$ORCA_CMD opt2.inp > opt2.out 2>&1
$ORCA_CMD opt3.inp > opt3.out 2>&1
